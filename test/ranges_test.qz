require "test"
require "http"
require "crypto"
require "base64"

# #16: times a peer chooses far from now (a Date centuries away, a
# `created` or `expires` past what a Time holds) give an
# HTTPSignatures::Error on the side they fall, never a RangeError, strict
# and lenient, through `verify` and `verify_signature` alike.
class RangesTest < Test::Case
  TARGET = "/t"
  NOW = Time.utc(2026, 11, 22)

  def key -> Crypto::RSA::PrivateKey = Crypto::RSA::PrivateKey.from_pem(File.read("test/fixtures/draft_test_key.pem"))
  def public_key -> Crypto::RSA::PublicKey = Crypto::RSA::PublicKey.from_pem(File.read("test/fixtures/draft_test_key.pub.pem"))

  # A signed Signature header over `covered` of `h`, with `created` and
  # `expires` written as given.
  def header(h: HTTP::Headers, covered: Array[String], created: String? = nil, expires: String? = nil) -> String
    text = HTTPSignatures.signing_string("POST", TARGET, h, covered,
                                         created: covered.include?("(created)") ? created : nil,
                                         expires: covered.include?("(expires)") ? expires : nil)
    params = "keyId=\"Test\",algorithm=\"hs2019\""
    params += ",created=#{created}" if created
    params += ",expires=#{expires}" if expires
    "#{params},headers=\"#{covered.join(" ")}\",signature=\"#{Base64.encode(key.sign(text, :sha256))}\""
  end

  # "ok" or the class of what `verify` raised; `verify_signature` must
  # answer the same, and nothing but an HTTPSignatures::Error may leave
  # either.
  def outcome(h: HTTP::Headers, lenient: Bool) -> String
    one = begin
      HTTPSignatures.verify(HTTP::Server::Request.build("POST", TARGET, h, ""), required: ["(request-target)"],
                            now: NOW, lenient: lenient) { |id| id == "Test" ? public_key : nil }
      "ok"
    rescue HTTPSignatures::Error => e
      e.class.name
    end
    two = begin
      HTTPSignatures.verify_signature("POST", TARGET, h, required: ["(request-target)"], now: NOW,
                                      lenient: lenient) { |id| id == "Test" ? public_key : nil }
      "ok"
    rescue HTTPSignatures::Error => e
      e.class.name
    end
    assert_equal(one, two)
    one
  end

  def both(h: HTTP::Headers, expected: String, what: String) -> Void
    [false, true].each { |l| assert_equal(expected, outcome(h, l), "#{what}, lenient: #{l}") }
  end

  def base -> HTTP::Headers = HTTP::Headers.empty.add("Host", "example.com")

  EXPIRED = "HTTPSignatures::Expired"
  MALFORMED = "HTTPSignatures::MalformedSignature"

  # A covered Date: year 1 and 1700 in the past, 9999 in the future, all
  # too far; the HTTP date forms Time cannot hold included.
  def test_a_date_far_away
    ["Mon, 01 Jan 0001 00:00:00 GMT", "Fri, 05 Jan 1700 21:31:40 GMT", "Fri, 31 Dec 9999 23:59:59 GMT",
     "Mon Jan  1 00:00:00 0001", "Fri Dec 31 23:59:59 9999"].each do |date|
      h = base.add("Date", date)
      both(h.add("Signature", header(h, ["(request-target)", "date"])), EXPIRED, date)
    end
    h = base.add("Date", "Fri, 99 Jan 2026 00:00:00 GMT")
    both(h.add("Signature", header(h, ["(request-target)", "date"])), MALFORMED, "day 99")
  end

  # `created`: past what a Time holds is in the future, covered or not; 0
  # (1970) is too old only when covered.
  def test_a_created_far_away
    ["999999999999", "9223372036", "9223372037"].each do |c|
      both(base.add("Signature", header(base, ["(request-target)", "(created)"], created: c)), EXPIRED, "covered #{c}")
      both(base.add("Signature", header(base, ["(request-target)"], created: c)), EXPIRED, "uncovered #{c}")
    end
    both(base.add("Signature", header(base, ["(request-target)", "(created)"], created: "0")), EXPIRED, "covered 0")
    both(base.add("Signature", header(base, ["(request-target)"], created: "0")), "ok", "uncovered 0")
    # A fraction of 9 digits (lenient only), on each side.
    far = header(base, ["(request-target)", "(created)"], created: "999999999999.999999999")
    assert_equal(MALFORMED, outcome(base.add("Signature", far), false))
    assert_equal(EXPIRED, outcome(base.add("Signature", far), true))
    zero = header(base, ["(request-target)"], created: "0.999999999")
    assert_equal("ok", outcome(base.add("Signature", zero), true))
  end

  # `expires`: past what a Time holds has not passed; 0 has.
  def test_an_expires_far_away
    ["999999999999", "999999999999.999999999", "9223372036", "9223372035.999999999"].each do |x|
      both(base.add("Signature", header(base, ["(request-target)", "(expires)"], expires: x)), "ok", "covered #{x}")
      both(base.add("Signature", header(base, ["(request-target)"], expires: x)), "ok", "uncovered #{x}")
    end
    ["0", "0.000000001", "1764000000"].each do |x|
      both(base.add("Signature", header(base, ["(request-target)", "(expires)"], expires: x)), EXPIRED, "covered #{x}")
    end
    both(base.add("Signature", header(base, ["(request-target)"], expires: "1234567890123")), MALFORMED, "13 digits")
  end

  # Other values a peer sends that a parser might choke on: each an
  # HTTPSignatures::Error.
  def test_other_extremes
    long = "9" * 10_000
    texts = [
      "keyId=\"Test\",signature=\"#{"A" * 100_000}\"",
      "keyId=\"Test\",signature=\"=====\"",
      "keyId=\"Test\",created=#{long},signature=\"AAAA\"",
      "keyId=\"Test\",expires=#{long},signature=\"AAAA\"",
      "keyId=\"Test\",headers=\"#{"x" * 100_000}\",signature=\"AAAA\"",
      "#{"k" * 100_000}=\"1\"",
      "keyId=\"#{"\\" * 1001}",
      "keyId=\"Test\",algorithm=\"hs2019\",headers=\"(created)\",created=,signature=\"AAAA\"",
    ]
    texts.each do |t|
      h = base.add("Signature", t)
      [false, true].each { |l| assert_true(outcome(h, l).start_with?("HTTPSignatures::"), t[0, 40]) }
    end
    # A Digest that is no Base64, or of another size: the body does not match.
    covered = ["(request-target)", "digest"]
    ["SHA-256=!!!", "SHA-256=#{"A" * 10_000}", "SHA-256=", "=", ","].each do |d|
      h = base.add("Digest", d)
      req = HTTP::Server::Request.build("POST", TARGET, h.add("Signature", header(h, covered)), "x")
      e = assert_raise(HTTPSignatures::DigestMismatch) do
        HTTPSignatures.verify(req, required: ["(request-target)"], now: NOW) { |_| public_key }
        nil
      end
      assert_equal("the body does not match its Digest header", e.message)
    end
  end

  # The key block's own exception passes through, neither caught nor
  # renamed.
  def test_the_key_blocks_exception_passes
    h = base.add("Signature", header(base, ["(request-target)"]))
    e = assert_raise(KeyError) do
      HTTPSignatures.verify(HTTP::Server::Request.build("POST", TARGET, h, ""), required: ["(request-target)"], now: NOW) do |_|
        raise KeyError.new("the key store is down")
      end
      nil
    end
    assert_equal("the key store is down", e.message)
    assert_raise(KeyError) do
      HTTPSignatures.verify_signature("POST", TARGET, h, required: ["(request-target)"], now: NOW) do |_|
        raise KeyError.new("the key store is down")
      end
      nil
    end
  end
end
